# FarmHelper Cloud Functions / Backend Environment Secrets Example
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
GOV_MARKET_API_KEY=your_government_market_api_key

# Transactional Email Delivery Provider Configuration
# Set EMAIL_PROVIDER_API_KEY for Resend (re_...) or SendGrid (SG....)
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key_or_resend_key
EMAIL_FROM_ADDRESS=no-reply@farmhelper.app
EMAIL_FROM_NAME=FarmHelper Weather Advisories

# SMTP Configuration (Optional alternative for Gmail / Brevo / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
