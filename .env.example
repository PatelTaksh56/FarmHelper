# Firebase Web Configuration Example
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# Google Maps JavaScript API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Backend API & Crop Doctor Diagnosis Configuration
# Set VITE_USE_MOCK_DIAGNOSIS=true to enable simulated AI diagnosis during offline testing without local backend server
VITE_USE_MOCK_DIAGNOSIS=true
VITE_API_BASE_URL=http://localhost:5000
VITE_BACKEND_URL=http://localhost:5001/diagnoseCrop

